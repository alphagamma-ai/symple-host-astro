---
import Search from '../components/Search.astro';
import {
  DEFAULT_LOCALE,
  LOCALE_LABELS,
  LOCALE_LANG,
  LOCALES,
  localeSwitchHref,
  localizePath,
  type Locale,
  uiCopy,
} from '../lib/locales';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  structuredData?: unknown[];
  /**
   * Opt this page into the Pagefind search index. Content pages (articles,
   * event detail pages, walkthroughs) set this; listing pages and duplicate
   * legacy routes leave it off so results stay one-entry-per-topic.
   */
  searchable?: boolean;
  /** Value recorded for the `category` search filter. Requires `searchable`. */
  searchCategory?: string;
  /**
   * Absolute URL to point the canonical tag at instead of this page's own URL.
   * Used when the same content also lives on www.symplehost.ai and that copy
   * is the one we want ranked. Only the canonical tag moves: og:url and the
   * .md alternate still describe this page.
   */
  canonical?: string;
}

const { title, locale = DEFAULT_LOCALE, searchable = false, searchCategory, structuredData = [], canonical } = Astro.props;
const copy = uiCopy[locale];
const description = Astro.props.description ?? copy.defaultDescription;
const currentPath = Astro.url.pathname;
const siteOrigin = Astro.site?.origin ?? 'https://help.symplehost.ai';
const canonicalUrl = new URL(currentPath === '/' ? '/' : currentPath.replace(/\/$/, '') || '/', siteOrigin).href;
const canonicalHref = canonical ?? canonicalUrl;
const ogImage = new URL('/logos/symplehost.png', siteOrigin).href;
const pageTitle = `${title} | ${copy.titleSuffix}`;
const isHome = currentPath === '/' || currentPath === `/${locale}/` || currentPath === `/${locale}`;

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://www.symplehost.ai/#organization',
      name: 'SympleHost',
      url: 'https://www.symplehost.ai',
      logo: 'https://help.symplehost.ai/logos/symplehost.png',
      description:
        'AI Co-Host and property management software for short-term rentals. Multi-channel messaging, dynamic pricing, operations, and direct bookings.',
      sameAs: [
        'https://www.linkedin.com/company/symplehost-ai',
        'https://www.symplehost.ai',
      ],
      contactPoint: [
        {
          '@type': 'ContactPoint',
          contactType: 'customer support',
          email: 'support@symplehost.ai',
          url: 'https://help.symplehost.ai/contact',
          availableLanguage: ['English', 'Japanese', 'Indonesian'],
        },
      ],
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'SG',
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://help.symplehost.ai/#website',
      url: 'https://help.symplehost.ai',
      name: 'SympleHost Knowledge Base',
      description:
        'Guides, tutorials, webinars, and platform documentation for SympleHost hosts and operators.',
      publisher: { '@id': 'https://www.symplehost.ai/#organization' },
      inLanguage: LOCALE_LANG[locale],
    },
    ...(isHome
      ? [
          {
            '@type': 'SoftwareApplication',
            name: 'SympleHost',
            applicationCategory: 'BusinessApplication',
            operatingSystem: 'Web',
            url: 'https://www.symplehost.ai',
            description:
              'AI Co-Host for short-term rentals: guest messaging, channel manager, dynamic pricing, operations, and direct bookings.',
            offers: {
              '@type': 'Offer',
              priceCurrency: 'USD',
              price: '15.00',
              description: 'From $15 per listing per month',
            },
            publisher: { '@id': 'https://www.symplehost.ai/#organization' },
          },
        ]
      : []),
  ],
};
---

<html lang={LOCALE_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="describedby" href="/openapi.json" type="application/openapi+json" />
    <link rel="service-desc" href="/openapi.json" type="application/openapi+json" />
    <link rel="api" href="/openapi.json" type="application/openapi+json" />
    <link rel="alternate" type="text/markdown" href={isHome ? '/index.md' : `${canonicalUrl.replace(/\/$/, '')}.md`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={isHome ? 'website' : 'article'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="SympleHost" />
    <meta property="og:site_name" content="SympleHost Knowledge Base" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    {structuredData.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Merriweather:wght@400;700;900&family=Noto+Sans+JP:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
    {/* Pagefind search UI. Both files are emitted by `pagefind --site dist`
        after the Astro build, so they are referenced as-is rather than
        bundled. The stylesheet is loaded before the site theme below so our
        `--pf-*` overrides win over Pagefind's own defaults. */}
    <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
    <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
    <style is:global>
      :root {
        /* Brand palette, Nov 2026 (Michelle's token mapping,
           "SympleHost-Design-Tokens-Mappting-202611"). Same values as the
           marketing site (symple-host-website app/globals.css). */
        --color-violet: #6C47FF;        /* primary brand accent; also success */
        --color-lime: #A6FF3B;          /* highlights on dark only; never text on light */
        --color-navy: #120B40;          /* primary dark background */
        --color-indigo: #2A1A8F;        /* secondary dark background */
        --color-white: #FFFFFF;
        --color-light: #F4F6FF;         /* light background, chips, tints */
        --color-coral: #FF6C5B;         /* warning */
        --color-magenta: #FF2B65;       /* error */
        --color-dark-gray: #1E1E1E;     /* headings, strongest text */
        --color-gray: #5A6271;          /* body text */
        --color-medium-gray: #8A919B;   /* hints, placeholders, muted */
        --color-light-gray: #D0D8E4;    /* borders; body text on dark */

        /* Existing names, now pointing at the new palette. */
        --primary-50: var(--color-light);
        --primary-100: var(--color-light);
        --primary-200: var(--color-light-gray);
        --primary-300: var(--color-light-gray);
        --primary-400: var(--color-violet);
        --primary-500: var(--color-violet);
        --primary-600: var(--color-violet);
        --primary-700: var(--color-violet);
        --primary-800: var(--color-indigo);
        --primary-900: var(--color-navy);

        --background: var(--color-white);
        --foreground: var(--color-dark-gray);
        --heading-color: var(--color-dark-gray);
        --muted-foreground: var(--color-gray);
        --muted-light: var(--color-medium-gray);
        --border: var(--color-light-gray);
        --border-light: var(--color-light-gray);
        --primary: var(--color-violet);

        /* Pagefind Component UI theme. Declared here (after its stylesheet)
           so these also override Pagefind's prefers-color-scheme: dark block —
           the site itself is light-only, and a dark search panel on a light
           page reads as a bug. */
        --pf-font: 'Inter', 'Noto Sans JP', ui-sans-serif, system-ui, sans-serif;
        --pf-text: var(--foreground);
        --pf-text-secondary: var(--muted-foreground);
        --pf-text-muted: var(--muted-light);
        --pf-background: #ffffff;
        --pf-border: var(--border);
        --pf-border-focus: var(--primary);
        --pf-border-radius: 8px;
        --pf-hover: var(--primary-50);
        --pf-mark: var(--primary-700);
        --pf-outline-focus: var(--primary);
        --pf-skeleton: var(--border-light);
        --pf-skeleton-shine: #ffffff;
        --pf-modal-backdrop: rgba(18, 11, 64, 0.45);
        --pf-modal-max-width: 40rem;
        --pf-dropdown-z-index: 60;
        /* No shadows in the Nov 2026 brand. */
        --pf-shadow-sm: none;
        --pf-shadow-md: none;
        --pf-shadow-lg: none;
        --pf-shadow: none;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      h1, h2, h3, h4, h5, h6 {
        font-family: 'Merriweather', Georgia, 'Times New Roman', serif;
      }

      html:lang(ja) h1,
      html:lang(ja) h2,
      html:lang(ja) h3,
      html:lang(ja) h4,
      html:lang(ja) h5,
      html:lang(ja) h6 {
        font-family: 'Noto Sans JP', 'Inter', ui-sans-serif, system-ui, sans-serif;
        font-weight: 700;
      }

      body {
        font-family: 'Inter', 'Noto Sans JP', ui-sans-serif, system-ui, -apple-system, sans-serif;
        background: var(--background);
        color: var(--foreground);
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: var(--primary);
        text-decoration: none;
        transition: color 0.15s;
      }
      a:hover { color: var(--primary-700); }
    </style>
  </head>
  <body>
    <header class="header">
      <div class="header-inner">
        <a href={localizePath('/', locale)} class="logo">
          <img src="/SympleHost-logo.svg" alt="SympleHost" class="logo-img" width="150" height="28" />
        </a>

        <nav class="nav">
          <a href={localizePath('/', locale)} class="nav-link">{copy.knowledgeBase}</a>
          <a href="https://www.symplehost.ai/pricing" class="nav-link">{copy.pricing}</a>
          <a href="https://www.symplehost.ai/blog" class="nav-link">{copy.blog}</a>
          <a href="https://www.symplehost.ai/contact" class="nav-link">{copy.contact}</a>
        </nav>

        <Search locale={locale} />

        <nav class="locale-switcher" aria-label={copy.language}>
          {LOCALES.map((item) => (
            <a
              href={localeSwitchHref(currentPath, item)}
              class:list={['locale-link', { active: item === locale }]}
              aria-current={item === locale ? 'page' : undefined}
            >
              {LOCALE_LABELS[item]}
            </a>
          ))}
        </nav>
      </div>
      <div class="header-gradient"></div>
    </header>

    {/* `data-pagefind-body` scopes the search index to the page content:
        header, locale switcher and footer are outside <main>, and pages that
        do not opt in (listings, legacy duplicate routes, redirect stubs) are
        left out of the index entirely. */}
    <main
      class="main"
      data-pagefind-body={searchable ? '' : undefined}
      data-pagefind-filter={searchable && searchCategory ? `category:${searchCategory}` : undefined}
      data-pagefind-meta={searchable && searchCategory ? `category:${searchCategory}` : undefined}
    >
      <slot />
    </main>

    <footer class="footer">
      <p>&copy; {new Date().getFullYear()} <a href="https://www.symplehost.ai">SympleHost</a>. {copy.copyright}</p>
      <p class="footer-links">
        <a href="/developers">Developers</a>
        · <a href="/openapi.json">OpenAPI</a>
        · <a href="/partner-api.html">Partner API</a>
        · <a href="/llms.txt">llms.txt</a>
        · <a href="/about">About</a>
        · <a href="/contact">Contact</a>
        · <a href="/privacy">Privacy</a>
      </p>
    </footer>

    <style>
      .header {
        background: var(--color-white);
        border-bottom: 1px solid var(--border-light);
        position: sticky;
        top: 0;
        z-index: 50;
      }
      .header-inner {
        max-width: 72rem;
        margin: 0 auto;
        padding: 0 2rem;
        height: 64px;
        display: flex;
        align-items: center;
        gap: 2rem;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--color-dark-gray);
        font-family: 'Merriweather', Georgia, 'Times New Roman', serif;
        font-weight: 700;
        font-size: 1.25rem;
        white-space: nowrap;
      }
      .logo:hover { color: var(--color-dark-gray); }
      .logo-img {
        display: block;
        height: 28px;
        width: auto;
      }
      .nav {
        display: flex;
        align-items: center;
        gap: 1.75rem;
        flex: 1;
      }
      .nav-link {
        color: var(--color-dark-gray);
        font-size: 1.2rem;
        font-weight: 400;
        white-space: nowrap;
        transition: color 0.15s;
      }
      .nav-link:hover { color: var(--primary); }
      .header-gradient {
        height: 3px;
        background: var(--color-violet);
      }
      .locale-switcher {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        margin-left: auto;
        padding: 0.2rem;
        border: 1px solid var(--border-light);
        border-radius: 999px;
        background: var(--color-white);
      }
      .locale-link {
        color: var(--color-dark-gray);
        font-size: 0.78rem;
        font-weight: 600;
        line-height: 1;
        white-space: nowrap;
        padding: 0.42rem 0.55rem;
        border-radius: 999px;
      }
      .locale-link:hover {
        color: var(--primary);
      }
      .locale-link.active {
        color: var(--color-white);
        background: var(--primary);
      }

      .main {
        max-width: 72rem;
        margin: 0 auto;
        padding: 2rem 2rem 4rem;
        width: 100%;
        flex: 1;
      }

      .footer {
        border-top: 1px solid var(--border);
        padding: 2rem;
        text-align: center;
        color: var(--muted-foreground);
        font-size: 0.85rem;
      }
      .footer a {
        color: var(--primary);
      }

      /* Between the mobile breakpoint and ~1024px the nav, the search trigger
         and the locale switcher all have to share one row. */
      @media (min-width: 769px) and (max-width: 1024px) {
        .header-inner { gap: 1rem; padding: 0 1rem; }
        .nav { gap: 1rem; }
        .nav-link { font-size: 1.05rem; }
      }

      @media (max-width: 768px) {
        .header-inner { padding: 0 0.75rem; gap: 0.6rem; }
        .nav { display: none; }
        .header-inner :global(.sh-search-header) { margin-left: auto; }
        .locale-switcher { margin-left: 0; }
        /* The header carries logo + search + three locales on one line at
           360px, so both ends tighten up. */
        .logo { font-size: 1.05rem; gap: 0.45rem; }
        .logo-img { height: 24px; }
        .locale-link { font-size: 0.72rem; padding: 0.4rem 0.45rem; }
        .main { padding: 1.5rem 1rem 3rem; }
      }
    </style>
  </body>
</html>
