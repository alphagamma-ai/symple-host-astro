---
import { getCollection } from 'astro:content';
import EventDetail from '../../components/EventDetail.astro';

export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => !data.draft);
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
---

{/* Legacy combined route — the canonical /videos/ and /webinars/ pages carry
    the search index entry for each event. */}
<EventDetail
  event={event}
  sectionTitle="Webinars & Videos"
  sectionHref="/webinars-and-videos/"
  searchable={false}
/>
