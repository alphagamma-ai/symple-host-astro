---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';

interface Props {
  /**
   * This page is rendered at /webinars-and-videos/walkthroughs/ and, via
   * `src/pages/videos/walkthroughs.astro`, at /videos/walkthroughs/. Only the
   * latter opts into the search index so the two copies do not both show up.
   */
  searchable?: boolean;
}

const { searchable = false } = Astro.props;

const all = await getCollection('walkthroughs', ({ data }) => !data.draft);
const sorted = all.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const walkthroughs = await Promise.all(
  sorted.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);
---

<Base
  title="Product walkthroughs"
  description="Short, focused video walkthroughs of every section of SympleHost — from listings and calendar to messages, guide books, team ops, and financial reporting."
  searchable={searchable}
  searchCategory="Videos"
>
  <nav class="breadcrumb" data-pagefind-ignore>
    <a href="/">All Topics</a>
    <span class="sep">/</span>
    <a href="/videos/">Videos</a>
    <span class="sep">/</span>
    <span>Product walkthroughs</span>
  </nav>

  <header class="page-header">
    <h1 class="page-title">Product walkthroughs</h1>
    <p class="page-desc">Short, focused video tours of every section of SympleHost. Pick a topic, hit play, and follow along.</p>
  </header>

  <div class="walkthrough-list">
    {walkthroughs.map(({ entry: w, Content }) => (
      <article class="walkthrough" id={w.id}>
        <div class="walkthrough-player">
          {w.data.youtubeId ? (
            <YouTubeEmbed videoId={w.data.youtubeId} title={w.data.title} />
          ) : w.data.videoFile ? (
            <video controls preload="metadata" poster={w.data.poster}>
              <source src={w.data.videoFile} type="video/mp4" />
            </video>
          ) : (
            <div class="coming-soon">
              {w.data.poster && <img src={w.data.poster} alt="" loading="lazy" />}
              <span>Video coming soon.</span>
            </div>
          )}
        </div>
        <div class="walkthrough-meta">
          <h2 class="walkthrough-title">{w.data.title}</h2>
          {w.data.duration && <span class="walkthrough-duration">{w.data.duration}</span>}
          {w.data.description && <p class="walkthrough-desc">{w.data.description}</p>}
        </div>
        <div class="walkthrough-notes">
          <Content />
        </div>
      </article>
    ))}
  </div>

  <style>
    .breadcrumb {
      font-size: 0.85rem;
      color: var(--muted-foreground);
      margin-bottom: 1rem;
    }
    .breadcrumb a { color: var(--muted-foreground); }
    .breadcrumb a:hover { color: var(--heading-color); }
    .sep { margin: 0 0.4rem; }

    .page-header {
      margin-bottom: 2.5rem;
    }
    .page-title {
      font-size: 2rem;
      font-weight: 700;
      color: var(--heading-color);
      letter-spacing: -0.01em;
      margin-bottom: 0.5rem;
    }
    .page-desc {
      color: var(--muted-foreground);
      font-size: 1rem;
      max-width: 42rem;
    }

    .walkthrough-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
      gap: 2rem;
    }

    .walkthrough {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1rem;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .walkthrough:hover {
      border-color: var(--primary-300);
      box-shadow: 0 4px 14px rgba(127, 86, 217, 0.08);
    }

    .walkthrough-player video {
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #000;
      border-radius: 10px;
      display: block;
    }
    .coming-soon {
      position: relative;
      display: grid;
      place-items: center;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      background: var(--primary-50);
      border-radius: 10px;
      border: 1px dashed var(--primary-200);
    }
    .coming-soon img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .coming-soon span {
      position: absolute;
      left: 1rem;
      bottom: 1rem;
      background: rgba(255, 255, 255, 0.92);
      border: 1px solid var(--border);
      border-radius: 999px;
      color: var(--heading-color);
      font-size: 0.78rem;
      font-weight: 700;
      padding: 0.45rem 0.75rem;
      box-shadow: 0 6px 18px rgba(38, 17, 63, 0.1);
    }

    .walkthrough-meta {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      padding: 0 0.25rem 0.25rem;
    }
    .walkthrough-title {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--heading-color);
      letter-spacing: -0.01em;
      margin: 0;
    }
    .walkthrough-duration {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted-foreground);
    }
    .walkthrough-desc {
      color: var(--muted-foreground);
      font-size: 0.93rem;
      line-height: 1.55;
      margin: 0;
    }
    .walkthrough-notes {
      border-top: 1px solid var(--border);
      padding: 0.85rem 0.25rem 0.1rem;
      color: var(--muted-foreground);
      font-size: 0.9rem;
      line-height: 1.6;
    }
    .walkthrough-notes :global(h2),
    .walkthrough-notes :global(h3) {
      color: var(--heading-color);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      margin: 0.85rem 0 0.35rem;
      text-transform: uppercase;
    }
    .walkthrough-notes :global(h2:first-child),
    .walkthrough-notes :global(h3:first-child) {
      margin-top: 0;
    }
    .walkthrough-notes :global(p) {
      margin: 0 0 0.7rem;
    }
    .walkthrough-notes :global(ul),
    .walkthrough-notes :global(ol) {
      margin: 0.25rem 0 0.85rem;
      padding-left: 1.15rem;
    }
    .walkthrough-notes :global(li) {
      margin: 0.2rem 0;
    }
    .walkthrough-notes :global(strong) {
      color: var(--heading-color);
    }

    .empty {
      color: var(--muted-foreground);
      font-size: 0.9rem;
      padding: 2rem;
      text-align: center;
      border: 1px dashed var(--border);
      border-radius: 10px;
    }
  </style>
</Base>
