---
// Site search — Pagefind Component UI (https://pagefind.app/docs/search-ui/).
//
// The index and the component bundle are generated by `pagefind --site dist`
// after `astro build`, so nothing here is bundled by Astro: `Base.astro` loads
// /pagefind/pagefind-component-ui.{css,js} as inline tags. In `astro dev` those
// files are served out of `dist/` by the dev middleware in astro.config.mjs.
//
// Variants:
//   header — a compact trigger button (⌘K / Ctrl-K) that opens the modal.
//   hero   — an inline searchbox with a results dropdown, used on the homepage.
import { DEFAULT_LOCALE, type Locale, uiCopy } from '../lib/locales';

interface Props {
  locale?: Locale;
  variant?: 'header' | 'hero';
}

const { locale = DEFAULT_LOCALE, variant = 'header' } = Astro.props;
const copy = uiCopy[locale];
---

{
  variant === 'hero' ? (
    <div class="sh-search sh-search-hero">
      <pagefind-searchbox
        instance="hero"
        placeholder={copy.searchHeroPlaceholder}
        max-results="6"
        show-sub-results
        hide-shortcut
      />
    </div>
  ) : (
    <div class="sh-search sh-search-header">
      <pagefind-modal-trigger instance="modal" placeholder={copy.search} shortcut="mod+k" />
      <pagefind-modal instance="modal" reset-on-close>
        <pagefind-modal-header>
          <pagefind-input instance="modal" placeholder={copy.searchPlaceholder} autofocus />
        </pagefind-modal-header>
        <pagefind-modal-body>
          <pagefind-filter-dropdown
            instance="modal"
            filter="category"
            label={copy.searchCategoryFilter}
          />
          <pagefind-summary instance="modal" default-message={copy.searchPrompt} />
          <pagefind-results instance="modal" max-results="20" max-sub-results="3" />
        </pagefind-modal-body>
        <pagefind-modal-footer>
          <pagefind-keyboard-hints instance="modal" />
        </pagefind-modal-footer>
      </pagefind-modal>
    </div>
  )
}

{/* Pagefind builds its UI at runtime, so these rules have to be global —
    Astro's scoped class hashes never reach the generated elements. */}
<style is:global>
  /* Keep the un-upgraded custom elements out of the layout until the
     component bundle defines them, otherwise the modal's markup flashes
     inline in the header on first paint. */
  pagefind-modal:not(:defined),
  pagefind-searchbox:not(:defined) {
    display: none;
  }

  .sh-search-header {
    display: flex;
    align-items: center;
  }

  .sh-search-header pagefind-modal-trigger {
    --pf-input-height: 34px;
    --pf-input-font-size: 0.9rem;
    width: 11rem;
  }

  /* `!important` throughout this block: Pagefind's stylesheet resets every
     `.pf-*` element with ID-level specificity, which a class selector here
     cannot outrank. */
  .sh-search-header .pf-trigger-text {
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }

  .sh-search-hero {
    max-width: 34rem;
    margin: 1.75rem auto 0;
  }

  .sh-search-hero pagefind-searchbox {
    --pf-input-height: 48px;
    --pf-input-font-size: 1rem;
    --pf-shadow-sm: 0 1px 2px rgba(88, 28, 135, 0.06);
  }

  /* Reserve the hero searchbox's height so the category grid below it does
     not jump once the bundle loads. */
  .sh-search-hero:has(pagefind-searchbox:not(:defined)) {
    min-height: 48px;
  }

  /* Collapse to an icon-only button once the nav gets tight — the placeholder
     and shortcut hint do not fit beside the nav links. `!important` is needed
     to beat Pagefind's own ID-specificity reset on `.pf-*` elements. */
  @media (max-width: 1150px) {
    .sh-search-header pagefind-modal-trigger {
      width: 2.75rem;
    }
    .sh-search-header .pf-trigger-text,
    .sh-search-header .pf-trigger-shortcut {
      display: none !important;
    }
  }
</style>
