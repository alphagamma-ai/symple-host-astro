---
import { DEFAULT_LOCALE, localizePath, type Locale } from '../lib/locales';

interface Props {
  compact?: boolean;
  currentSlug?: string;
  locale?: Locale;
}

const { compact = false, currentSlug, locale = DEFAULT_LOCALE } = Astro.props;

const setupPath = [
  {
    step: '01',
    label: 'Sign up',
    title: 'Create your account',
    description: 'Sign up with your business email and start your free trial. It takes a few minutes.',
    href: '/getting-started/creating-your-account',
    linkLabel: 'Create account',
    matches: ['creating-your-account'],
  },
  {
    step: '02',
    label: 'Connect',
    title: 'Connect your first property',
    description: 'Read the 3 things to know, then import from Airbnb, add it manually, or invite the owner to connect.',
    href: '/getting-started/before-you-connect-airbnb',
    linkLabel: 'Before you connect',
    matches: [
      'before-you-connect-airbnb',
      'import-listings-from-ota',
      'adding-a-listing-manually',
      'invite-owner-to-connect-airbnb',
      'airbnb-integration-overview',
    ],
  },
  {
    step: '03',
    label: 'Check',
    title: 'See your bookings arrive',
    description: 'Open your calendar and reservations to check your existing bookings came across.',
    href: '/getting-started/viewing-your-first-reservation',
    linkLabel: 'View reservations',
    matches: ['viewing-your-first-reservation'],
  },
  {
    step: '04',
    label: 'Grow',
    title: 'Set your price, then add channels',
    description: 'Make your base price your real price, then connect Booking.com and other channels with their own markup.',
    href: '/platform-guides/set-channel-markups',
    linkLabel: 'Set channel markups',
    matches: ['connect-booking-com', 'connect-vrbo', 'connect-expedia', 'connect-agoda', 'connect-trip-com', 'connect-makemytrip'],
  },
  {
    step: '05',
    label: 'Finish setup',
    title: 'Set up the rest around real bookings',
    description: 'Company profile, team, guest messages and AI Co-Host, and payments for direct bookings.',
    href: '/getting-started/setting-up-company-profile',
    linkLabel: 'Finish setup',
    matches: ['setting-up-company-profile', 'add-team-members-and-roles', 'your-first-24-hours-in-symplehost', 'set-up-payments-stripe'],
  },
];

const currentIndex = currentSlug
  ? setupPath.findIndex((item) => item.matches.includes(currentSlug))
  : -1;
---

<section
  class:list={['setup-path', { compact }]}
  aria-labelledby={compact ? 'setup-path-compact-title' : 'setup-path-title'}
  data-pagefind-ignore
>
  <div class="setup-path-head">
    <p class="setup-kicker">Recommended setup path</p>
    <h2 id={compact ? 'setup-path-compact-title' : 'setup-path-title'}>
      {compact ? 'Stay on the setup path' : 'Do these in order'}
    </h2>
    {!compact && <p>Most hosts connect a property first, then set up the rest around their real bookings.</p>}
  </div>
  <ol class="setup-steps">
    {setupPath.map((item, index) => {
      const isCurrent = index === currentIndex;
      const isDone = currentIndex > index;
      return (
        <li class:list={['setup-step', { current: isCurrent, done: isDone }]}>
          <a
            href={localizePath(item.href, locale)}
            class="setup-card"
            aria-current={isCurrent ? 'step' : undefined}
          >
            <span class="setup-number">{item.step}</span>
            <span class="setup-label">{item.label}</span>
            <span class="setup-title">{item.title}</span>
            {!compact && <span class="setup-desc">{item.description}</span>}
            <span class="setup-link">{compact ? (isCurrent ? 'Current guide' : item.linkLabel) : item.linkLabel}</span>
          </a>
        </li>
      );
    })}
  </ol>
</section>

<style>
  .setup-path {
    margin: 0 0 3rem;
    padding: 1.25rem;
    border: 1px solid var(--color-light-gray);
    border-radius: 8px;
    background: var(--color-white);
  }
  .setup-path-head {
    max-width: 40rem;
    margin-bottom: 1.25rem;
  }
  .setup-kicker {
    color: var(--color-dark-gray);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
    margin-bottom: 0.4rem;
    text-transform: uppercase;
  }
  .setup-path h2 {
    color: var(--heading-color);
    font-size: 1.45rem;
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }
  .setup-path-head p:last-child {
    color: var(--muted-foreground);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .setup-steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    list-style: none;
    counter-reset: none;
  }
  .setup-step {
    position: relative;
    min-width: 0;
  }
  .setup-step:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 2.2rem;
    right: -0.5rem;
    width: 1rem;
    height: 1px;
    background: var(--color-light-gray);
    z-index: 2;
  }
  .setup-card {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    min-height: 15.25rem;
    height: 100%;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--color-white);
    color: var(--foreground);
    transition: border-color 0.15s, transform 0.15s;
  }
  .setup-card:hover {
    color: var(--foreground);
    border-color: var(--color-violet);
    transform: translateY(-2px);
  }
  .setup-number {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-violet);
    color: var(--color-white);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 0.8rem;
  }
  .setup-label {
    color: var(--color-dark-gray);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
    margin-bottom: 0.45rem;
    text-transform: uppercase;
  }
  .setup-title {
    color: var(--foreground);
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: 0.45rem;
  }
  .setup-desc {
    color: var(--muted-foreground);
    font-size: 0.8rem;
    line-height: 1.45;
    margin-bottom: 1rem;
  }
  .setup-link {
    align-self: end;
    color: var(--color-violet);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .setup-step.current .setup-card {
    border-color: var(--color-violet);
    background: var(--color-light);
  }
  .setup-step.done .setup-number {
    background: var(--color-violet);
  }

  .setup-path.compact {
    position: sticky;
    top: calc(64px + 0.75rem);
    z-index: 8;
    margin: 0 0 1.75rem;
    padding: 0.8rem;
    background: var(--color-white);
    backdrop-filter: blur(14px);
  }
  .setup-path.compact .setup-path-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    max-width: none;
    margin-bottom: 0.65rem;
  }
  .setup-path.compact .setup-kicker {
    margin: 0;
    font-size: 0.66rem;
  }
  .setup-path.compact h2 {
    flex: 0 0 auto;
    margin: 0;
    font-size: 0.95rem;
  }
  .setup-path.compact .setup-steps {
    grid-template-columns: repeat(5, minmax(7.5rem, 1fr));
    gap: 0.45rem;
    overflow-x: auto;
    padding-bottom: 0.15rem;
  }
  .setup-path.compact .setup-step:not(:last-child)::after {
    display: none;
  }
  .setup-path.compact .setup-card {
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto auto;
    column-gap: 0.55rem;
    min-height: 5.25rem;
    padding: 0.65rem;
  }
  .setup-path.compact .setup-number {
    grid-row: 1 / 4;
    width: 1.8rem;
    height: 1.8rem;
    margin: 0;
    font-size: 0.66rem;
  }
  .setup-path.compact .setup-label {
    margin-bottom: 0.2rem;
    font-size: 0.58rem;
  }
  .setup-path.compact .setup-title {
    margin-bottom: 0.25rem;
    font-size: 0.82rem;
  }
  .setup-path.compact .setup-link {
    font-size: 0.68rem;
  }

  @media (max-width: 980px) {
    .setup-steps {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .setup-step:not(:last-child)::after {
      top: auto;
      right: auto;
      left: 2.1rem;
      bottom: -0.75rem;
      width: 1px;
      height: 0.75rem;
    }
    .setup-card {
      min-height: 0;
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto auto auto;
      column-gap: 0.9rem;
    }
    .setup-number {
      grid-row: 1 / 5;
      margin-bottom: 0;
    }
    .setup-path.compact {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .setup-path.compact .setup-path-head {
      display: block;
    }
    .setup-path.compact .setup-kicker {
      margin-bottom: 0.25rem;
    }
    .setup-path.compact .setup-steps {
      grid-template-columns: repeat(5, minmax(8.75rem, 1fr));
    }
  }
</style>
