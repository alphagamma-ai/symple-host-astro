---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import GettingStartedPath from '../GettingStartedPath.astro';
import LocalizedArticleFallback from './LocalizedArticleFallback.astro';
import {
  DEFAULT_LOCALE,
  getArticleDescription,
  getArticleTitle,
  getCategoryTitle,
  localizePath,
  type Locale,
  uiCopy,
} from '../../lib/locales';
import { getLocalizedArticleBody } from '../../lib/localized-article-bodies';

interface Props {
  article: Awaited<ReturnType<typeof getCollection<'articles'>>>[number];
  category?: Awaited<ReturnType<typeof getCollection<'categories'>>>[number];
  locale?: Locale;
}

const { article, category, locale = DEFAULT_LOCALE } = Astro.props;
const copy = uiCopy[locale];
const localizedArticleBody = await getLocalizedArticleBody(article.id, locale);
const { Content } = await render(localizedArticleBody ?? article);
const shouldRenderFallback = locale !== DEFAULT_LOCALE && !localizedArticleBody;
const articleTitle = getArticleTitle(article, locale);
const articleDescription = getArticleDescription(article, locale);
const rawArticleBody = (localizedArticleBody?.body ?? article.body ?? '').trim();
const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const allCategories = await getCollection('categories');
const categoryById = new Map(allCategories.map((entry) => [entry.id, entry]));
const siteOrigin = Astro.site?.origin ?? 'https://help.symplehost.ai';
const articlePath = localizePath(`/${article.data.category}/${article.id}/`, locale);
const articleUrl = new URL(articlePath, siteOrigin).href;
const categoryPath = category ? localizePath(`/${category.id}/`, locale) : localizePath('/', locale);
const categoryUrl = new URL(categoryPath, siteOrigin).href;

type ArticleEntry = Props['article'];

function plainText(markdown: string): string {
  return markdown
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`([^`]+)`/g, '$1')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/[#>*_~|]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

function excerpt(markdown: string, maxLength = 280): string {
  const text = plainText(markdown);
  if (text.length <= maxLength) return text;
  const clipped = text.slice(0, maxLength).replace(/\s+\S*$/, '');
  return `${clipped}...`;
}

function extractFaqItems(markdown: string) {
  if (!markdown) return [];
  const lines = markdown.split(/\r?\n/);
  const items: { question: string; answer: string }[] = [];

  for (let i = 0; i < lines.length; i += 1) {
    const match = lines[i].match(/^###\s+(.+\?)\s*$/);
    if (!match) continue;

    const answerLines: string[] = [];
    for (let j = i + 1; j < lines.length; j += 1) {
      if (/^#{2,3}\s+/.test(lines[j])) break;
      answerLines.push(lines[j]);
    }

    const answer = excerpt(answerLines.join('\n'), 360);
    if (answer) items.push({ question: plainText(match[1]), answer });
  }

  return items.slice(0, 20);
}

function getRelatedLabel(candidate: ArticleEntry): string {
  const relatedCategory = categoryById.get(candidate.data.category);
  return candidate.data.section ?? (relatedCategory ? getCategoryTitle(relatedCategory, locale) : candidate.data.category);
}

function relatedScore(candidate: ArticleEntry): number {
  let score = 0;
  if (candidate.data.category === article.data.category) score += 6;
  if (candidate.data.section && candidate.data.section === article.data.section) score += 5;

  const currentTags = new Set(article.data.tags ?? []);
  const sharedTags = (candidate.data.tags ?? []).filter((tag) => currentTags.has(tag)).length;
  score += sharedTags * 3;

  return score;
}

const relatedArticles = allArticles
  .filter((candidate) => candidate.id !== article.id)
  .map((candidate) => ({ article: candidate, score: relatedScore(candidate) }))
  .filter((item) => item.score > 0)
  .sort((a, b) => b.score - a.score || (a.article.data.sectionOrder ?? 999) - (b.article.data.sectionOrder ?? 999))
  .slice(0, 4)
  .map((item) => item.article);

const articleDate = article.data.date ? new Date(article.data.date).toISOString() : undefined;
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: copy.allTopics, item: new URL(localizePath('/', locale), siteOrigin).href },
    ...(category ? [{ '@type': 'ListItem', position: 2, name: getCategoryTitle(category, locale), item: categoryUrl }] : []),
    { '@type': 'ListItem', position: category ? 3 : 2, name: articleTitle, item: articleUrl },
  ],
};

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${articleUrl}#article`,
  headline: articleTitle,
  description: articleDescription,
  url: articleUrl,
  mainEntityOfPage: articleUrl,
  inLanguage: locale === 'jp' ? 'ja' : locale === 'id' ? 'id' : 'en',
  ...(articleDate ? { datePublished: articleDate, dateModified: articleDate } : {}),
  author: { '@type': 'Organization', name: 'SympleHost', url: 'https://www.symplehost.ai' },
  publisher: { '@id': 'https://www.symplehost.ai/#organization' },
  image: new URL('/logos/symplehost.png', siteOrigin).href,
};

const faqItems = article.data.category === 'faqs' ? extractFaqItems(rawArticleBody) : [];
const faqJsonLd = faqItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;

const structuredData = [breadcrumbJsonLd, articleJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])];

const formattedDate = article.data.date
  ? new Date(article.data.date).toLocaleDateString(locale === 'jp' ? 'ja-JP' : locale === 'id' ? 'id-ID' : 'en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
---

<Base
  title={articleTitle}
  description={articleDescription}
  locale={locale}
  searchable
  searchCategory={category ? getCategoryTitle(category, locale) : undefined}
  structuredData={structuredData}
>
  <nav class="breadcrumb" data-pagefind-ignore>
    <a href={localizePath('/', locale)}>{copy.allTopics}</a>
    <span class="sep">/</span>
    {category && <><a href={localizePath(`/${category.id}`, locale)}>{getCategoryTitle(category, locale)}</a><span class="sep">/</span></>}
    <span>{articleTitle}</span>
  </nav>

  {article.data.category === 'getting-started' && locale === 'en' && (
    <GettingStartedPath compact currentSlug={article.id} locale={locale} />
  )}

  <article class="article">
    <header class="article-header">
      <h1 class="article-title">{articleTitle}</h1>
      {/* Kept out of the index: the date and the tag chips have no whitespace
          between them once flattened to text, so they only ever surface as
          noise in search excerpts. */}
      <div class="article-meta" data-pagefind-ignore>
        {formattedDate && <span class="article-date">{copy.updated} {formattedDate}</span>}
        {locale === DEFAULT_LOCALE && article.data.tags && article.data.tags.length > 0 && (
          <div class="article-tags">
            {article.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="article-content">
      {shouldRenderFallback ? (
        <LocalizedArticleFallback article={article} locale={locale as Exclude<Locale, 'en'>} />
      ) : (
        <Content />
      )}
    </div>
  </article>

  {relatedArticles.length > 0 && (
    <aside class="related-articles" aria-labelledby="related-articles-title">
      <h2 id="related-articles-title">Related guides</h2>
      <div class="related-grid">
        {relatedArticles.map((related) => (
          <a class="related-card" href={localizePath(`/${related.data.category}/${related.id}/`, locale)}>
            <span>{getRelatedLabel(related)}</span>
            <strong>{getArticleTitle(related, locale)}</strong>
            {getArticleDescription(related, locale) && <p>{getArticleDescription(related, locale)}</p>}
          </a>
        ))}
      </div>
    </aside>
  )}

  <style>
    .breadcrumb {
      font-size: 0.85rem;
      color: var(--muted-foreground);
      margin-bottom: 1.5rem;
    }
    .breadcrumb a { color: var(--muted-foreground); }
    .breadcrumb a:hover { color: var(--primary); }
    .sep { margin: 0 0.4rem; }
    .locale-notice {
      display: flex;
      gap: 0.65rem;
      align-items: baseline;
      margin: 0 0 1.5rem;
      padding: 0.85rem 1rem;
      color: var(--foreground);
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 0.9rem;
    }
    .locale-notice strong {
      color: var(--heading-color);
      white-space: nowrap;
    }

    .article-header {
      margin-bottom: 2rem;
    }
    .article-title {
      font-size: 2rem;
      font-weight: 700;
      color: var(--heading-color);
      letter-spacing: -0.01em;
      margin-bottom: 0.75rem;
    }
    .article-meta {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .article-date {
      color: var(--muted-foreground);
      font-size: 0.85rem;
    }
    .article-tags {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .tag {
      color: var(--primary);
      font-size: 0.8rem;
      font-weight: 500;
      padding: 0.15rem 0.5rem;
      background: var(--primary-50);
      border-radius: 4px;
    }

    .article-content {
      font-size: 0.95rem;
      line-height: 1.75;
      color: var(--muted-foreground);
    }
    .article-content :global(h2) {
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--heading-color);
      margin: 2rem 0 0.75rem;
    }
    .article-content :global(h3) {
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--heading-color);
      margin: 1.5rem 0 0.5rem;
    }
    .article-content :global(p) {
      margin-bottom: 1rem;
    }
    .article-content :global(ul),
    .article-content :global(ol) {
      margin: 0.5rem 0 1rem 1.5rem;
    }
    .article-content :global(li) {
      margin-bottom: 0.35rem;
    }
    .article-content :global(strong) {
      color: var(--foreground);
      font-weight: 600;
    }
    .article-content :global(a) {
      color: var(--primary);
      text-decoration: underline;
    }
    .article-content :global(blockquote) {
      border-left: 3px solid var(--primary-300);
      padding-left: 1rem;
      margin: 1rem 0;
      color: var(--muted-foreground);
      font-style: italic;
    }
    .article-content :global(code) {
      background: var(--primary-50);
      padding: 0.15rem 0.35rem;
      border-radius: 3px;
      font-size: 0.875em;
    }
    .article-content :global(pre) {
      background: #1e1e2e;
      color: #cdd6f4;
      padding: 1rem;
      border-radius: 6px;
      overflow-x: auto;
      margin: 1rem 0;
    }
    .article-content :global(pre code) {
      background: none;
      padding: 0;
    }
    .article-content :global(img) {
      display: block;
      max-width: 100%;
      max-height: 480px;
      width: auto;
      height: auto;
      margin: 1.25rem auto;
      border: 1px solid var(--border);
      border-radius: 6px;
      object-fit: contain;
    }
    .article-content :global(hr) {
      border: none;
      border-top: 1px solid var(--border);
      margin: 2rem 0;
    }
    .article-content :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 1.25rem 0;
      font-size: 0.9rem;
      display: block;
      overflow-x: auto;
    }
    .article-content :global(thead) {
      background: var(--primary-50);
    }
    .article-content :global(th) {
      text-align: left;
      font-weight: 600;
      color: var(--heading-color);
      padding: 0.65rem 0.9rem;
      border-bottom: 2px solid var(--border);
      white-space: nowrap;
    }
    .article-content :global(td) {
      padding: 0.65rem 0.9rem;
      border-bottom: 1px solid var(--border);
      vertical-align: top;
      color: var(--foreground);
    }
    .article-content :global(tbody tr:last-child td) {
      border-bottom: none;
    }
    .article-content :global(tbody tr:hover) {
      background: var(--primary-50);
    }

    .related-articles {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
    }
    .related-articles h2 {
      margin: 0 0 1rem;
      color: var(--heading-color);
      font-size: 1.15rem;
      font-weight: 700;
    }
    .related-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.9rem;
    }
    .related-card {
      display: block;
      min-height: 100%;
      padding: 1rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: #ffffff;
      color: var(--foreground);
    }
    .related-card:hover {
      border-color: var(--primary-300);
      background: var(--primary-50);
      color: var(--foreground);
    }
    .related-card span {
      display: block;
      margin-bottom: 0.35rem;
      color: var(--primary);
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .related-card strong {
      display: block;
      color: var(--heading-color);
      font-size: 0.98rem;
      line-height: 1.35;
    }
    .related-card p {
      margin: 0.5rem 0 0;
      color: var(--muted-foreground);
      font-size: 0.86rem;
      line-height: 1.55;
    }

    @media (max-width: 640px) {
      .locale-notice {
        display: block;
      }
      .locale-notice strong {
        display: block;
        margin-bottom: 0.25rem;
      }
      .related-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Base>
